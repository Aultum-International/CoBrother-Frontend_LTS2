# Local dev — copy to .env.local (npm run dev uses localhost:8080 by default via src/config/urls.js)
VITE_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:5173
VITE_API_PROXY_TARGET=http://localhost:8080

# Domain search TLDs, OpenProvider register URL, and API credentials:
# configured only in backend application.yaml (GET /api/v1/domain/config)

