# =============================================================================
# CoBrother frontend — environment variables
# =============================================================================
#
# **Committed defaults (production)** — see `src/config/urls.js`:
#   Backend: https://backend.cobrother.com
#   App:     https://cobrother.com
#
# **Local stack** — create `.env.local` (gitignored) with:
#   VITE_API_URL=http://localhost:8080
#   VITE_APP_URL=http://localhost:5173
#   And point vite.config.js proxy targets to http://localhost:8080
#
# **Production deploy** (CI / hosting) — optional overrides:
#   VITE_API_URL=https://backend.cobrother.com
#   VITE_APP_URL=https://cobrother.com
#
# =============================================================================
